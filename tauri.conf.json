{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AION2 Auras",
  "version": "0.1.0",
  "identifier": "com.taylorjohannsen.aion2auras",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "AION2 Auras",
        "width": 760,
        "height": 160,
        "center": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
