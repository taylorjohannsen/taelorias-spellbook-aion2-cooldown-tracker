{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tjcd",
  "identifier": "tjcd",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "tjcd",
        "width": 760,
        "height": 160,
        "center": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "tjcd",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFNEQ0RjQwNzAwMTU1NTcKUldSWFZRRndRRTlOM3RLZnhOVG5LNnNzcS8zZHFjQ1hrVzB3UnE0TlMxQlo2S1dMUHRlV0s4cVcK",
      "endpoints": [
        "https://github.com/taylorjohannsen/tjcd/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
